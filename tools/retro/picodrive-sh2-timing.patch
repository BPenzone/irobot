+/* --- real-hardware timing model (env SH2_TIMING=1) ---
+ * A 4 KB, 4-way, 16-byte-line cache per CPU, and extra cycles for cache
+ * misses and uncached accesses, roughly from the 32X documentation. */
+#include <stdlib.h>
+static int tm_on = -1;
+static int tm_rom_line, tm_sdram_line, tm_fb_line, tm_rom_acc, tm_sdram_acc, tm_fb_acc, tm_fb_wr, tm_sdram_wr, tm_vdp, tm_sys;
+static u32 tm_tag[2][64][4], tm_age[2][64][4], tm_clock[2];
+static int tm_ce[2];
+unsigned int tm_stats[2][8];
+unsigned int tm_rom_hist[2][4096];  /* ROM misses per 1 KB */
+unsigned int tm_sdram_hist[2][256]; /* SDRAM misses per 1 KB */   /* misses rom/sdram/fb, uncached rom/sdram/fb, extra cycles lo */
+static int tm_env(const char *n, int d) { const char *v = getenv(n); return v ? atoi(v) : d; }
+static void tm_init(void)
+{
+	tm_on = tm_env("SH2_TIMING", 0);
+	tm_rom_line = tm_env("TM_ROM_LINE", 48);
+	tm_sdram_line = tm_env("TM_SDRAM_LINE", 12);
+	tm_fb_line = tm_env("TM_FB_LINE", 24);
+	tm_rom_acc = tm_env("TM_ROM_ACC", 10);
+	tm_sdram_acc = tm_env("TM_SDRAM_ACC", 10);
+	tm_fb_acc = tm_env("TM_FB_ACC", 8);
+	tm_fb_wr = tm_env("TM_FB_WR", 2);
+	tm_sdram_wr = tm_env("TM_SDRAM_WR", 2);
+	tm_vdp = tm_env("TM_VDP", 5);
+	tm_sys = tm_env("TM_SYS", 1);
+}
+static void tm_purge(int c) { memset(tm_tag[c], 0, sizeof tm_tag[c]); }
+static int tm_cost(SH2 *sh2, u32 a, int size, int write)
+{
+	int c = sh2->is_slave, region;
+	u32 p = a & 0x1fffffff, top = a >> 29;
+	if (tm_on < 0) tm_init();
+	if (!tm_on) return 0;
+	if (a >= 0xfffffe00) {
+		if (write && (a & ~1) == 0xfffffe92) { if (a == 0xfffffe92 || size != 1) {} }
+		return 0;
+	}
+	if (p >= 0x06000000 && p < 0x06040000) region = 1;
+	else if (p >= 0x02000000 && p < 0x02400000) region = 0;
+	else if (p >= 0x04000000 && p < 0x04040000) region = 2;
+	else if (p >= 0x4000 && p < 0x4100) return tm_sys;
+	else if (p >= 0x4100 && p < 0x4400) return tm_vdp;
+	else return 0;
+	if (write) return region == 1 ? tm_sdram_wr : region == 2 ? tm_fb_wr : 0;
+	if (top == 0 && tm_ce[c]) {
+		u32 line = p >> 4, set = line & 63, tag = line | 0x80000000;
+		int w, lru = 0;
+		tm_clock[c]++;
+		for (w = 0; w < 4; w++)
+			if (tm_tag[c][set][w] == tag) { tm_age[c][set][w] = tm_clock[c]; return 0; }
+		for (w = 1; w < 4; w++)
+			if (tm_age[c][set][w] < tm_age[c][set][lru]) lru = w;
+		tm_tag[c][set][lru] = tag; tm_age[c][set][lru] = tm_clock[c];
+		tm_stats[c][region]++;
+		if (region == 0) tm_rom_hist[c][(p >> 10) & 4095]++;
+		if (region == 1) tm_sdram_hist[c][(p >> 10) & 255]++;
+		return region == 0 ? tm_rom_line : region == 1 ? tm_sdram_line : tm_fb_line;
+	}
+	tm_stats[c][3 + region]++;
+	{ int n = region == 0 ? tm_rom_acc : region == 1 ? tm_sdram_acc : tm_fb_acc;
+	  return (region != 1 && size == 4) ? 2 * n : n; }
+}
+static void tm_ccr(SH2 *sh2, u32 a, u32 d)
+{
+	if (a == 0xfffffe92) {
+		if (d & 0x10) tm_purge(sh2->is_slave);
+		tm_ce[sh2->is_slave] = d & 1;
+	}
+}
